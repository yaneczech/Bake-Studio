{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vijual Bake Studio",
  "version": "0.1.0",
  "identifier": "com.vijual.bakestudio",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @vijual-bake-studio/studio",
    "beforeBuildCommand": "npm run build --workspace @vijual-bake-studio/studio",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vijual Bake Studio",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [],
    "resources": [
      "resources/ffmpeg/README.md",
      "resources/ffmpeg/ffmpeg.bin",
      "resources/ffmpeg/ffprobe.bin"
    ]
  }
}
